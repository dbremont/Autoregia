# Autoregia local configuration template. Copy to .env and fill in real
# values (.env is git-ignored). Loaded by run.sh (deploys) and by app/app.py
# via python-dotenv; real env vars still win.
AUTOREGIA_PORT=8081

# CouchDB connection (used by storage/couchdb_store.py)
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me

# Optional prefix prepended to every database name (e.g. "dev_")
#COUCHDB_DB_PREFIX=
